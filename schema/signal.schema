;; Spirit admission judge contract, wire revision 2.
[
  JudgeAdmission
]
[
  AdmissionJudged
  RequestRejected
]
{
  JudgeAdmission AdmissionJudgePacket
  AdmissionJudged AdmissionJudgeResponse
  RequestRejected SpiritJudgeRequestRejection

  AdmissionJudgePacket { AdmissionJudgeOperation RecordSet DatabaseMarker }
  AdmissionJudgeOperation [Record Propose Clarify ResolveClarification Supersede Retire ChangeRecord]

  AdmissionJudgeResponse { AdmissionJudgeVerdict JudgeDiagnostic }
  AdmissionJudgeVerdict [Accept Reject]
  AdmissionRejectionReason [Duplicate Contradiction Compound NonIntent NegativeGuideline Matter UnclearDomain ClarifyTramples ClarifyLosesMeaning SupersedeTargetMissing RetrievalInsufficient MissingTestimony TestimonyFabricated InsufficientWarrant ImportanceUnsupported JudgeUnavailable JudgeMalformed JudgeTimedOut]
  JudgeDiagnostic { RedactedText ContentHashes }
  ContentHashes (Vector ContentHash)
  ContentHash String
  RedactedText String

  RecordRequest signal-spirit.RecordRequest
  Proposal signal-spirit.Proposal
  Clarification signal-spirit.Clarification
  ClarificationResolution signal-spirit.ClarificationResolution
  Supersession signal-spirit.Supersession
  Retirement signal-spirit.Retirement
  RecordChange signal-spirit.RecordChange
  RecordSet signal-spirit.RecordSet
  DatabaseMarker signal-spirit.DatabaseMarker
}
